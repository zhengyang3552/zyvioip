<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      紧凑胶囊：默认 Chip 高 32dp、左右内边距 16dp，
      在摘要里三个并排显得过大。这里收紧到 24dp 高、10dp 内边距。
    -->
    <style name="Widget.ZyvioIp.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipMinHeight">22dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="chipBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
</resources>

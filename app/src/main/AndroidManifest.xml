<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      NetworkWatcher 用 registerDefaultNetworkCallback 监听 Wi-Fi/移动网络切换，
      以便自动重新探测本机 IP。该 API 需要 ACCESS_NETWORK_STATE，
      缺失会在运行时抛 SecurityException（不只是 lint 警告）。
      这是普通权限，安装即授予，不需要运行时申请。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      不再用 android:usesCleartextTraffic="true" 全局放行明文 HTTP：
      ip-api.com 免费版只支持 http，其余供应商都是 https。用 networkSecurityConfig
      只给这一个域名开例外，其它明文流量仍然被系统拒绝。
    -->
    <application
        android:name="com.zyvioip.app.ZyvioIpApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZyvioIp">
        <activity
            android:name="com.zyvioip.app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ZyvioIp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
